<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.2.0</Version>
    <Author>HAAAAe1</Author>
    <Name>SubOps</Name>
    <Punchline>部队工房潜水艇作业：一键收取、自动修理、重新委派</Punchline>
    <Description>读取部队工房 4 艘潜水艇的返航时间与零件耐久，自动进屋、开航行管制面板、逐艘确认收取，出航前自动修理耐久为 0 的零件，最后按原航线再次委派。支持多角色轮换：从名册第一个角色开始逐个处理，收完自动切下一个。</Description>
    <RepoUrl>https://github.com/HAAAAe1/MyPlugins</RepoUrl>
    <Tags>潜水艇;工房;部队;submarine;workshop;fc</Tags>
    <CategoryTags>utility</CategoryTags>
    <AssemblyName>SubOps</AssemblyName>
    <RootNamespace>SubOps</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

</Project>
